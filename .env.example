# Copy to .env (never commit .env). Placeholders only.
# Used by services/api. Real values for staging/prod live in GCP Secret Manager.

# local | test | staging | prod
APP_ENV=local
PORT=8080

# astrologyapi | mock   (mock is rejected when APP_ENV=prod)
ASTRO_PROVIDER=mock
ASTROLOGYAPI_USER_ID=<your-user-id>
ASTROLOGYAPI_API_KEY=<your-api-key>

# HMAC pepper for pseudonymous uid hashes in logs (32+ random bytes, base64)
UID_HASH_PEPPER=<generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">

# Firebase / GCP
FIREBASE_PROJECT_ID=demo-astro-app
APP_CHECK_ENFORCED=false

# Quota: provider calls per user per UTC day
QUOTA_PROVIDER_CALLS_PER_DAY=30
