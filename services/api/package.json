{
  "name": "@astro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --sourcemap --external:fastify --external:zod --outfile=dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/with-emulators.mjs --config ../../infra/firebase/firebase.json --only auth,firestore -- vitest run",
    "test:unit": "vitest run --exclude \"test/integration/**\"",
    "test:perf": "node ../../scripts/with-emulators.mjs --config ../../infra/firebase/firebase.json --only auth,firestore -- vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@astro/shared": "*",
    "fastify": "5.12.7",
    "firebase-admin": "14.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
