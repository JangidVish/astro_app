{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-RENDER-URL.onrender.com",
        "EXPO_PUBLIC_FIREBASE_API_KEY": "REPLACE-WITH-FIREBASE-WEB-apiKey",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "REPLACE-WITH-FIREBASE-WEB-authDomain",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "REPLACE-WITH-FIREBASE-WEB-projectId",
        "EXPO_PUBLIC_FIREBASE_APP_ID": "REPLACE-WITH-FIREBASE-WEB-appId"
      }
    }
  }
}
