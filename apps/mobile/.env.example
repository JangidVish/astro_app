# Copy to apps/mobile/.env (gitignored). EXPO_PUBLIC_* values are inlined into the app bundle:
# never put secrets here. Provider keys live on the API server only.

# API base URL. Android emulator: http://10.0.2.2:8080 ; iOS simulator: http://127.0.0.1:8080
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080

# Firebase web config (public identifiers, not secrets). For local development against the
# emulators any non-empty values work with the demo project:
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-astro-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-astro-app
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app-id
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
