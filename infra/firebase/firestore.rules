rules_version = '2';

// Clients never access Firestore directly. All reads and writes go through the API,
// which uses a service account (Admin SDK bypasses these rules) and scopes every
// query to the uid from the verified Firebase ID token. See docs/architecture.md section 7.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
