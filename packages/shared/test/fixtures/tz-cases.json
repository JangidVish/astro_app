    },
    {
      "id": "london-double-summer-1941",
      "zone": "Europe/London",
      "date": "1941-06-01",
      "time": "12:00",
      "expect": { "status": "ok", "offset": 120 },
      "source": "tzdb europe: BDST +2 in wartime summers"
    },
    {
      "id": "sydney-summer",
      "zone": "Australia/Sydney",
      "date": "2021-01-15",
      "time": "12:00",
      "expect": { "status": "ok", "offset": 660 },
      "source": "tzdb australasia: southern-hemisphere DST (AEDT)"
    },
    {
      "id": "sydney-winter",
      "zone": "Australia/Sydney",
      "date": "2021-07-15",
      "time": "12:00",
      "expect": { "status": "ok", "offset": 600 },
      "source": "tzdb australasia: AEST"
    },
    {
      "id": "sydney-gap",
      "zone": "Australia/Sydney",
      "date": "2021-10-03",
      "time": "02:30",
      "expect": { "status": "gap" },
      "source": "tzdb australasia: 02:00 -> 03:00 on 2021-10-03"
    },
    {
      "id": "sydney-overlap",
      "zone": "Australia/Sydney",
      "date": "2021-04-04",
      "time": "02:30",
      "expect": { "status": "ambiguous", "offsets": [660, 600] },
      "source": "tzdb australasia: 02:00-03:00 repeated on 2021-04-04"
    },
    {
      "id": "sao-paulo-dst-2018",
      "zone": "America/Sao_Paulo",
      "date": "2018-01-15",
      "time": "12:00",
      "expect": { "status": "ok", "offset": -120 },
      "source": "tzdb southamerica: Brazil DST until 2019"
    },
    {
      "id": "sao-paulo-no-dst-2020",
      "zone": "America/Sao_Paulo",
      "date": "2020-01-15",
      "time": "12:00",
      "expect": { "status": "ok", "offset": -180 },
      "source": "tzdb southamerica: DST abolished 2019"
    },
    {
      "id": "dhaka-dst-2009",
      "zone": "Asia/Dhaka",
      "date": "2009-07-01",
      "time": "12:00",
      "expect": { "status": "ok", "offset": 420 },
      "source": "tzdb asia: Bangladesh DST 2009-06-19 to 2009-12-31"
    },
    {
      "id": "karachi-dst-2008",
      "zone": "Asia/Karachi",
      "date": "2008-07-01",
      "time": "12:00",
      "expect": { "status": "ok", "offset": 360 },
      "source": "tzdb asia: Pakistan DST 2008"
    },
    {
      "id": "kiritimati-plus14",
      "zone": "Pacific/Kiritimati",
      "date": "2020-06-01",
      "time": "12:00",
      "expect": { "status": "ok", "offset": 840 },
      "source": "tzdb australasia: +14"
    },
    {
      "id": "samoa-skipped-day",
      "zone": "Pacific/Apia",
      "date": "2011-12-30",
      "time": "12:00",
      "expect": { "status": "gap" },
      "source": "tzdb australasia: Samoa skipped 2011-12-30 entirely"
    },
    {
      "id": "unknown-time-noon",
      "zone": "Asia/Kolkata",
      "date": "1990-05-10",
      "time": null,
      "expect": {
        "status": "ok",
        "offset": 330,
        "instant": "1990-05-10T06:30:00Z",
        "timeAssumedNoon": true
      },
      "source": "FR-8: unknown time -> 12:00 local"
    }
  ]
}
